{
  "name": "ccm-backoffice-api",
  "version": "1.0.0",
  "description": "CallCenterMatch BackOffice API — Express + MongoDB + Groq AI",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "seed": "ts-node-dev --transpile-only src/utils/seed.ts",
    "create-admin": "ts-node-dev --transpile-only src/utils/createAdmin.ts",
    "diagnose-users": "ts-node-dev --transpile-only src/utils/diagnoseUsers.ts",
    "diagnose-db": "ts-node-dev --transpile-only src/utils/diagnoseDb.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.4",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.6.3",
    "morgan": "^1.10.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "5.4.5"
  }
}
